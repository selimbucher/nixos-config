                     const auto& [plugin_proxy, _] =
                         get_proxy(request.owner_instance_id);
 
+                    // NOTE: Not awaited. These are void notifications, so
+                    //       we acknowledge immediately and let the host run
+                    //       the callback whenever its main thread is free.
+                    //       Blocking here until the callback ran deadlocks:
+                    //       if our main thread is currently inside a blocking
+                    //       plugin call (e.g. clap_plugin_state::save() for an
+                    //       undo point), and the Wine-side main thread is
+                    //       parked inside a mutually recursive send waiting
+                    //       for this Ack (e.g. FabFilter Pro-L 2 firing
+                    //       clap_host_latency.changed() from a GUI click),
+                    //       then neither side can ever make progress.
                     run_on_main_thread(
                         plugin_proxy,
-                        [&, host = plugin_proxy.host_,
+                        [host = plugin_proxy.host_,
                          latency = plugin_proxy.host_extensions_.latency]() {
                             latency->changed(host);
-                        })
-                        .wait();
+                        });
 
                     return Ack{};
                 },
