--- a/dlls/mshtml/mutation.c
+++ b/dlls/mshtml/mutation.c
@@ -53,6 +53,61 @@
 
 static nsIContentUtils *content_utils;
 
+static const WCHAR *get_process_exe_name(void)
+{
+    const WCHAR *p, *name = NtCurrentTeb()->Peb->ProcessParameters->ImagePathName.Buffer;
+    if((p = wcsrchr(name, '/'))) name = p + 1;
+    if((p = wcsrchr(name, '\\'))) name = p + 1;
+    return name;
+}
+
+static BOOL read_browser_emulation(HKEY root, const WCHAR *exe_name, DWORD *value)
+{
+    DWORD size = sizeof(*value), type;
+    HKEY key;
+    LONG res;
+
+    res = RegOpenKeyExW(root, L"Software\\Microsoft\\Internet Explorer\\Main\\FeatureControl\\FEATURE_BROWSER_EMULATION",
+                        0, KEY_QUERY_VALUE, &key);
+    if(res != ERROR_SUCCESS)
+        return FALSE;
+    res = RegQueryValueExW(key, exe_name, NULL, &type, (BYTE*)value, &size);
+    RegCloseKey(key);
+    return res == ERROR_SUCCESS && type == REG_DWORD;
+}
+
+/* Default document mode the host process asked for through the
+ * FEATURE_BROWSER_EMULATION feature control key (7000, 8000/8888, 9000/9999,
+ * 10000/10001, 11000/11001), or COMPAT_MODE_INVALID when it set none. */
+static compat_mode_t get_browser_emulation_mode(void)
+{
+    static volatile int cache = -2;
+    int ret = cache;
+
+    if(ret == -2) {
+        const WCHAR *exe_name = get_process_exe_name();
+        DWORD value;
+
+        ret = COMPAT_MODE_INVALID;
+        if(read_browser_emulation(HKEY_CURRENT_USER, exe_name, &value) ||
+           read_browser_emulation(HKEY_LOCAL_MACHINE, exe_name, &value)) {
+            if(value >= 11000)
+                ret = COMPAT_MODE_IE11;
+            else if(value >= 10000)
+                ret = COMPAT_MODE_IE10;
+            else if(value >= 9000)
+                ret = COMPAT_MODE_IE9;
+            else if(value >= 8000)
+                ret = COMPAT_MODE_IE8;
+            else if(value >= 7000)
+                ret = COMPAT_MODE_IE7;
+            TRACE("FEATURE_BROWSER_EMULATION for %s = %lu -> mode %d\n", debugstr_w(exe_name), value, ret);
+        }
+        cache = ret;
+    }
+    return ret;
+}
