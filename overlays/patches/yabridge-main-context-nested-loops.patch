+// The one-shot timer `poke()` arms on the poke window. `USER_TIMER_MINIMUM`
+// (10 ms) bounds the latency of host calls made while a plugin sits in a
+// nested message loop; outside such loops the asio loop runs them at once.
+static constexpr UINT_PTR POKE_TIMER_ID = 1;
+
+void MainContext::poke() noexcept {
+    // When called from the GUI thread itself `asio::dispatch()` already ran
+    // the task inline (or the loop will get to it), no need to poke ourselves
+    if (is_gui_thread()) {
+        return;
+    }
+
+    // One pending poke covers every task queued until it fires; see the
+    // comment on `poke_armed_` for why this must not be a posted message.
+    if (poke_armed_.exchange(true)) {
+        return;
+    }
+    if (const HWND poke_window = poke_window_.load()) {
+        SetTimer(poke_window, POKE_TIMER_ID, USER_TIMER_MINIMUM, nullptr);
+    } else {
+        poke_armed_.store(false);
+    }
+}
+
+LRESULT CALLBACK MainContext::poke_window_proc(HWND hwnd,
+                                               UINT msg,
+                                               WPARAM wparam,
+                                               LPARAM lparam) noexcept {
+    if (msg == WM_TIMER && wparam == POKE_TIMER_ID) {
+        KillTimer(hwnd, POKE_TIMER_ID);
+        if (auto* self = reinterpret_cast<MainContext*>(
+                GetWindowLongPtrW(hwnd, GWLP_USERDATA))) {
+            // Clear before polling: a task that queues more work re-arms.
+            self->poke_armed_.store(false);
+            // Running the context from within a handler that is itself being
+            // executed by `context_.run()` is allowed by asio: this behaves
+            // like a nested event loop, exactly what the plugin is doing with
+            // the Win32 message loop around us. `poll()` only runs the
+            // handlers that are ready right now and never blocks.
+            try {
+                self->context_.poll();
+            } catch (const std::exception& error) {
+                std::cerr << "Error while running the main context from a "
+                             "nested message loop: "
+                          << error.what() << std::endl;
+            }
+        }
+
+        return 0;
+    }
+
+    return DefWindowProcW(hwnd, msg, wparam, lparam);
+}
