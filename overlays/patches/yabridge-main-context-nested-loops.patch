+// Private message for `poke()`. `WM_APP` messages are never sent by the
+// system, and the window is ours alone.
+static constexpr UINT WM_YABRIDGE_POKE = WM_APP + 0x59;
+
+void MainContext::poke() noexcept {
+    // When called from the GUI thread itself `asio::dispatch()` already ran
+    // the task inline (or the loop will get to it), no need to poke ourselves
+    if (is_gui_thread()) {
+        return;
+    }
+
+    if (const HWND poke_window = poke_window_.load()) {
+        PostMessageW(poke_window, WM_YABRIDGE_POKE, 0, 0);
+    }
+}
+
+LRESULT CALLBACK MainContext::poke_window_proc(HWND hwnd,
+                                               UINT msg,
+                                               WPARAM wparam,
+                                               LPARAM lparam) noexcept {
+    if (msg == WM_YABRIDGE_POKE) {
+        if (auto* self = reinterpret_cast<MainContext*>(
+                GetWindowLongPtrW(hwnd, GWLP_USERDATA))) {
+            // Running the context from within a handler that is itself being
+            // executed by `context_.run()` is allowed by asio: this behaves
+            // like a nested event loop, exactly what the plugin is doing with
+            // the Win32 message loop around us. `poll()` only runs the
+            // handlers that are ready right now and never blocks.
+            try {
+                self->context_.poll();
+            } catch (const std::exception& error) {
+                std::cerr << "Error while running the main context from a "
+                             "nested message loop: "
+                          << error.what() << std::endl;
+            }
+        }
+
+        return 0;
+    }
+
+    return DefWindowProcW(hwnd, msg, wparam, lparam);
+}
