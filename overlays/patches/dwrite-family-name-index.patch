+static void fontcollection_remove_family_names(struct dwrite_fontcollection *collection,
+        struct dwrite_fontfamily_data *family, UINT32 index)
+{
+    UINT32 i, count = IDWriteLocalizedStrings_GetCount(family->familyname);
+
+    for (i = 0; i < count; ++i)
+    {
+        struct family_name_entry *name;
+        struct rb_entry *entry;
+        WCHAR buffer[255];
+
+        if (FAILED(IDWriteLocalizedStrings_GetString(family->familyname, i, buffer, ARRAY_SIZE(buffer))))
+            continue;
+        if (!(entry = rb_get(&collection->family_names, buffer)))
+            continue;
+        name = RB_ENTRY_VALUE(entry, struct family_name_entry, entry);
+        if (name->index != index)
+            continue;
+        rb_remove(&collection->family_names, entry);
+        free(name);
+    }
+}
+
 static HRESULT fontcollection_add_family(struct dwrite_fontcollection *collection,
         struct dwrite_fontfamily_data *family)
 {
+    UINT32 i, count = IDWriteLocalizedStrings_GetCount(family->familyname);
+
     if (!dwrite_array_reserve((void **)&collection->family_data, &collection->size, collection->count + 1,
             sizeof(*collection->family_data)))
     {
         return E_OUTOFMEMORY;
     }
 
+    for (i = 0; i < count; ++i)
+    {
+        struct family_name_entry *name;
+        WCHAR buffer[255];
+
+        if (FAILED(IDWriteLocalizedStrings_GetString(family->familyname, i, buffer, ARRAY_SIZE(buffer))))
+            continue;
+        if (rb_get(&collection->family_names, buffer))
+            continue;
+        if (!(name = malloc(offsetof(struct family_name_entry, name[wcslen(buffer) + 1]))))
+        {
+            fontcollection_remove_family_names(collection, family, collection->count);
+            return E_OUTOFMEMORY;
+        }
+        name->index = collection->count;
+        wcscpy(name->name, buffer);
+        rb_put(&collection->family_names, name->name, &name->entry);
+    }
+
     collection->family_data[collection->count++] = family;
     return S_OK;
 }
