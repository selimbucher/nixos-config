+ * arrays. Build and run with
+ *   x86_64-w64-mingw32-gcc -o gen.exe gen_shape_bytecode.c -ld3dcompiler_47
+ *   wine gen.exe > shape_bytecode.h
+ * This file is not part of the build. */
+#include <windows.h>
+#include <d3dcompiler.h>
+#include <stdio.h>
+#include "shape_hlsl.h"
+
+static void dump(const char *var, const char *src, size_t size, const char *name, const char *profile)
+{
+    ID3DBlob *blob, *errors = NULL;
+    const BYTE *p;
+    size_t i, n;
+    HRESULT hr;
+
+    if (FAILED(hr = D3DCompile(src, size, name, NULL, NULL, "main", profile, 0, 0, &blob, &errors)))
+    {
+        fprintf(stderr, "%s: %#lx %s\n", name, hr, errors ? (char *)errors->lpVtbl->GetBufferPointer(errors) : "");
+        exit(1);
+    }
+    p = blob->lpVtbl->GetBufferPointer(blob);
+    n = blob->lpVtbl->GetBufferSize(blob);
+    printf("static const BYTE %s[] =\n{", var);
+    for (i = 0; i < n; ++i)
+        printf("%s0x%02x,", i % 16 ? " " : "\n    ", p[i]);
+    printf("\n};\n\n");
+}
+
+int main(void)
+{
+    printf("/* Generated from shape_hlsl.h by gen_shape_bytecode.c: D3DCompile(code, size, name,\n"
+           " * NULL, NULL, \"main\", \"vs_4_0\" or \"ps_4_0\", 0, 0). Regenerate when the HLSL changes. */\n\n");
+    dump("shape_vs_bytecode_outline", shape_vs_code_outline, sizeof(shape_vs_code_outline) - 1, "outline", "vs_4_0");
+    dump("shape_vs_bytecode_bezier_outline", shape_vs_code_bezier_outline, sizeof(shape_vs_code_bezier_outline) - 1, "bezier_outline", "vs_4_0");
+    dump("shape_vs_bytecode_arc_outline", shape_vs_code_arc_outline, sizeof(shape_vs_code_arc_outline) - 1, "arc_outline", "vs_4_0");
+    dump("shape_vs_bytecode_triangle", shape_vs_code_triangle, sizeof(shape_vs_code_triangle) - 1, "triangle", "vs_4_0");
+    dump("shape_vs_bytecode_curve", shape_vs_code_curve, sizeof(shape_vs_code_curve) - 1, "curve", "vs_4_0");
+    dump("shape_vs_bytecode_fill_aa", shape_vs_code_fill_aa, sizeof(shape_vs_code_fill_aa) - 1, "fill_aa", "vs_4_0");
+    dump("shape_ps_bytecode", shape_ps_code, sizeof(shape_ps_code) - 1, "ps", "ps_4_0");
+    return 0;
+}
