+    /**
+     * Joins all pooled sending threads. Any pending `fork()` calls must have
+     * returned before the helper is destroyed, same as with the previous
+     * thread-per-call implementation where `fork()` joined its own thread.
+     */
+    ~MutualRecursionHelper() {
+        for (auto& worker : thread_pool_) {
+            {
+                std::lock_guard lock(worker->mutex);
+                worker->shutdown = true;
+            }
+            worker->cv.notify_one();
+        }
+        // The `Thread` destructors implicitly join, like `std::jthread`
+        thread_pool_.clear();
+    }
+
    private:
     /**
+     * A reusable sending thread for `fork()`, see the perf note there.
+     */
+    struct PooledWorker {
+        std::mutex mutex;
+        std::condition_variable cv;
+        /** The task to run. Empty when the worker is idle. */
+        std::function<void()> task;
+        bool shutdown = false;
+        /**
+         * The actual thread. Started in `run_on_pooled_thread()` after the
+         * rest of the struct has been initialized, joined on destruction.
+         */
+        Thread thread;
+    };
+
+    /**
+     * Runs `task` on an idle pooled worker thread, spawning a new worker only
+     * when all existing ones are busy (i.e. once per level of concurrent or
+     * nested mutual recursion, instead of once per call).
+     */
+    void run_on_pooled_thread(std::function<void()> task) {
+        PooledWorker* worker = nullptr;
+        {
+            std::lock_guard lock(thread_pool_mutex_);
+            if (!idle_workers_.empty()) {
+                worker = idle_workers_.back();
+                idle_workers_.pop_back();
+            }
+        }
+
+        if (!worker) {
+            auto new_worker = std::make_unique<PooledWorker>();
+            worker = new_worker.get();
+            worker->thread = Thread([this, worker]() { worker_loop(worker); });
+
+            std::lock_guard lock(thread_pool_mutex_);
+            thread_pool_.push_back(std::move(new_worker));
+        }
+
+        {
+            std::lock_guard lock(worker->mutex);
+            worker->task = std::move(task);
+        }
+        worker->cv.notify_one();
+    }
+
+    void worker_loop(PooledWorker* worker) {
+        std::unique_lock lock(worker->mutex);
+        while (true) {
+            worker->cv.wait(
+                lock, [&]() { return worker->task || worker->shutdown; });
+            if (worker->shutdown) {
+                return;
+            }
+
+            std::function<void()> task = std::move(worker->task);
+            worker->task = {};
+
+            lock.unlock();
+            task();
+            lock.lock();
+
+            // Mark ourselves as idle again so the next `fork()` reuses this
+            // thread. Lock order note: `run_on_pooled_thread()` never holds
+            // `thread_pool_mutex_` while taking a worker's mutex, so taking
+            // `thread_pool_mutex_` while holding our own mutex here is safe.
+            std::lock_guard pool_lock(thread_pool_mutex_);
+            idle_workers_.push_back(worker);
+        }
+    }
