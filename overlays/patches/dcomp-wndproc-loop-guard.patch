                         msg, hwnd, real, orphan_forward_count);
-            return CallWindowProcW(real, hwnd, msg, wparam, lparam);
+            return dcomp_guarded_forward(real, hwnd, msg, wparam, lparam);
         }
         return DefWindowProcW(hwnd, msg, wparam, lparam);
     }
@@ -5054,7 +5082,7 @@ static LRESULT CALLBACK dcomp_target_wndproc(HWND hwnd, UINT msg, WPARAM wparam,
             if (!target->covers_window)
             {
                 LRESULT ret = orig_wndproc
-                        ? CallWindowProcW(orig_wndproc, hwnd, msg, wparam, lparam)
+                        ? dcomp_guarded_forward(orig_wndproc, hwnd, msg, wparam, lparam)
                         : DefWindowProcW(hwnd, msg, wparam, lparam);
 
