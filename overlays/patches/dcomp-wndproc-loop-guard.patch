+/* Break wndproc forward loops (stack overflow with JUCE 8 + PACE-wrapped
+ * plugins): several parties subclass the same HWND (the application, copy
+ * protection, this dll and dcomp).  The "original" procedures they save are
+ * user32 winproc handles rather than raw function pointers, so identity
+ * checks cannot detect a cycle in the chain, and one message can forward
+ * around the ring forever until the stack overflows.  Cap the same-window
+ * forward nesting depth; legitimate nesting never comes close. */
+static LRESULT dcomp_guarded_forward(WNDPROC proc, HWND hwnd, UINT msg, WPARAM wparam, LPARAM lparam)
+{
+    UINT_PTR depth = (UINT_PTR)GetPropW(hwnd, L"__wine_dcomp_fwd_depth");
+    LRESULT ret;
+
+    if (!proc)
+        return DefWindowProcW(hwnd, msg, wparam, lparam);
+    if (depth >= 32)
+    {
+        static unsigned int loop_count;
+        if (++loop_count <= 3 || !(loop_count % 1000))
+            ERR("Breaking wndproc forward loop on %p (msg %#x, #%u).\n", hwnd, msg, loop_count);
+        return DefWindowProcW(hwnd, msg, wparam, lparam);
+    }
+    SetPropW(hwnd, L"__wine_dcomp_fwd_depth", (HANDLE)(depth + 1));
+    ret = CallWindowProcW(proc, hwnd, msg, wparam, lparam);
+    SetPropW(hwnd, L"__wine_dcomp_fwd_depth", (HANDLE)depth);
+    return ret;
+}
+
