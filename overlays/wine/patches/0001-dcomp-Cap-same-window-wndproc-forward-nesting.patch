From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Selim Bucher <me@selim.one>
Date: Sat, 21 Nov 2026 22:52:20 +0100
Subject: [PATCH] dcomp: Cap same-window wndproc forward nesting.

dcomp.dll and dxgi.dll subclass the editor window alongside JUCE and PACE.
The saved window procedures are user32 winproc handles, so identity checks
cannot see a cycle; the chain can close into a ring and one forwarded
message then recurses until the 1 MB thread stack overflows (soothe3's
editor killed its host). Same-window forward nesting is capped at 32.
---
 dlls/dcomp/device.c | 40 ++++++++++++++++++++++++++++++++++------
 dlls/dxgi/factory.c | 44 ++++++++++++++++++++++++++++++++++++--------
 2 files changed, 70 insertions(+), 14 deletions(-)

diff --git a/dlls/dcomp/device.c b/dlls/dcomp/device.c
index bc633ffaec1856d8798db21455773232c0910551..80ce6c32c779905ce70307245fc0c225d4653af1 100644
--- a/dlls/dcomp/device.c
+++ b/dlls/dcomp/device.c
@@ -8163,6 +8163,34 @@ static void dcomp_target_animation_tick(struct dcomp_target *target)
     LeaveCriticalSection(&target->device->cs);
 }
 
+
+/* Break wndproc forward loops (stack overflow with JUCE 8 + PACE-wrapped
+ * plugins): several parties subclass the same HWND (the application, copy
+ * protection, this dll and dcomp).  The "original" procedures they save are
+ * user32 winproc handles rather than raw function pointers, so identity
+ * checks cannot detect a cycle in the chain, and one message can forward
+ * around the ring forever until the stack overflows.  Cap the same-window
+ * forward nesting depth; legitimate nesting never comes close. */
+static LRESULT dcomp_guarded_forward(WNDPROC proc, HWND hwnd, UINT msg, WPARAM wparam, LPARAM lparam)
+{
+    UINT_PTR depth = (UINT_PTR)GetPropW(hwnd, L"__wine_dcomp_fwd_depth");
+    LRESULT ret;
+
+    if (!proc)
+        return DefWindowProcW(hwnd, msg, wparam, lparam);
+    if (depth >= 32)
+    {
+        static unsigned int loop_count;
+        if (++loop_count <= 3 || !(loop_count % 1000))
+            ERR("Breaking wndproc forward loop on %p (msg %#x, #%u).\n", hwnd, msg, loop_count);
+        return DefWindowProcW(hwnd, msg, wparam, lparam);
+    }
+    SetPropW(hwnd, L"__wine_dcomp_fwd_depth", (HANDLE)(depth + 1));
+    ret = CallWindowProcW(proc, hwnd, msg, wparam, lparam);
+    SetPropW(hwnd, L"__wine_dcomp_fwd_depth", (HANDLE)depth);
+    return ret;
+}
+
 /* Phase 5: WndProc subclass — suppresses WM_ERASEBKGND to prevent white-on-open.
  * WM_PAINT is forwarded to the original WndProc so that VSTGUI can call
  * BeginDraw → Render → EndDraw → Commit in response to paint requests. */
@@ -8190,7 +8218,7 @@ static LRESULT CALLBACK dcomp_target_wndproc(HWND hwnd, UINT msg, WPARAM wparam,
             if (++orphan_forward_count <= 3 || !(orphan_forward_count % 1000))
                 FIXME("Forwarding message %#x for orphaned subclass on hwnd %p to %p #%u.\n",
                         msg, hwnd, real, orphan_forward_count);
-            return CallWindowProcW(real, hwnd, msg, wparam, lparam);
+            return dcomp_guarded_forward(real, hwnd, msg, wparam, lparam);
         }
         return DefWindowProcW(hwnd, msg, wparam, lparam);
     }
@@ -8295,7 +8323,7 @@ static LRESULT CALLBACK dcomp_target_wndproc(HWND hwnd, UINT msg, WPARAM wparam,
             if (!target->covers_window)
             {
                 LRESULT ret = orig_wndproc
-                        ? CallWindowProcW(orig_wndproc, hwnd, msg, wparam, lparam)
+                        ? dcomp_guarded_forward(orig_wndproc, hwnd, msg, wparam, lparam)
                         : DefWindowProcW(hwnd, msg, wparam, lparam);
 
                 dcomp_target_composite_tree(target, FALSE);
@@ -8311,7 +8339,7 @@ static LRESULT CALLBACK dcomp_target_wndproc(HWND hwnd, UINT msg, WPARAM wparam,
             {
                 struct dcomp_texture *texture = target->root_visual->foreign_proxy->texture_content;
                 LRESULT ret = orig_wndproc
-                        ? CallWindowProcW(orig_wndproc, hwnd, msg, wparam, lparam)
+                        ? dcomp_guarded_forward(orig_wndproc, hwnd, msg, wparam, lparam)
                         : DefWindowProcW(hwnd, msg, wparam, lparam);
 
                 if (texture)
@@ -8348,7 +8376,7 @@ static LRESULT CALLBACK dcomp_target_wndproc(HWND hwnd, UINT msg, WPARAM wparam,
                 break;
 
             ret = orig_wndproc
-                    ? CallWindowProcW(orig_wndproc, hwnd, msg, wparam, lparam)
+                    ? dcomp_guarded_forward(orig_wndproc, hwnd, msg, wparam, lparam)
                     : DefWindowProcW(hwnd, msg, wparam, lparam);
 
             if (target->device && target->last_present_qpc == present_before)
@@ -8412,12 +8440,12 @@ static LRESULT CALLBACK dcomp_target_wndproc(HWND hwnd, UINT msg, WPARAM wparam,
         target->orig_wndproc = NULL;
         if (!orig_wndproc)
             return DefWindowProcW(hwnd, msg, wparam, lparam);
-        return CallWindowProcW(orig_wndproc, hwnd, msg, wparam, lparam);
+        return dcomp_guarded_forward(orig_wndproc, hwnd, msg, wparam, lparam);
     }
 
     if (!orig_wndproc)
         return DefWindowProcW(hwnd, msg, wparam, lparam);
-    return CallWindowProcW(orig_wndproc, hwnd, msg, wparam, lparam);
+    return dcomp_guarded_forward(orig_wndproc, hwnd, msg, wparam, lparam);
 }
 
 static HRESULT STDMETHODCALLTYPE dcomp_device_Commit(IDCompositionDevice *iface)
diff --git a/dlls/dxgi/factory.c b/dlls/dxgi/factory.c
index bd89ad4c5cc7d0e1d94d711e92a1d63398e04475..7680c8ad5efca0b0758fd8ba655167e3fb1bd777 100644
--- a/dlls/dxgi/factory.c
+++ b/dlls/dxgi/factory.c
@@ -567,6 +567,34 @@ static void dcomp_restore_parent_clip(HWND hwnd)
     }
 }
 
+
+/* Break wndproc forward loops (stack overflow with JUCE 8 + PACE-wrapped
+ * plugins): several parties subclass the same HWND (the application, copy
+ * protection, this dll and dcomp).  The "original" procedures they save are
+ * user32 winproc handles rather than raw function pointers, so identity
+ * checks cannot detect a cycle in the chain, and one message can forward
+ * around the ring forever until the stack overflows.  Cap the same-window
+ * forward nesting depth; legitimate nesting never comes close. */
+static LRESULT dcomp_guarded_forward(WNDPROC proc, HWND hwnd, UINT msg, WPARAM wparam, LPARAM lparam)
+{
+    UINT_PTR depth = (UINT_PTR)GetPropW(hwnd, L"__wine_dcomp_fwd_depth");
+    LRESULT ret;
+
+    if (!proc)
+        return DefWindowProcW(hwnd, msg, wparam, lparam);
+    if (depth >= 32)
+    {
+        static unsigned int loop_count;
+        if (++loop_count <= 3 || !(loop_count % 1000))
+            ERR("Breaking wndproc forward loop on %p (msg %#x, #%u).\n", hwnd, msg, loop_count);
+        return DefWindowProcW(hwnd, msg, wparam, lparam);
+    }
+    SetPropW(hwnd, L"__wine_dcomp_fwd_depth", (HANDLE)(depth + 1));
+    ret = CallWindowProcW(proc, hwnd, msg, wparam, lparam);
