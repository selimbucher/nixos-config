+}
+
 /* Lightweight subclass for DComp popup windows (menus, tooltips).
  * Only blocks WM_ERASEBKGND and re-blits composition content on WM_PAINT.
  * NO timer, NO periodic Present â avoids dual-swapchain
@@ -595,7 +623,7 @@ static LRESULT CALLBACK dcomp_popup_wndproc(HWND hwnd, UINT msg, WPARAM wparam,
              * the application painted (its EndPaint already validated the
              * update region, a second BeginPaint would get an empty clip). */
             if (orig)
-                CallWindowProcW(orig, hwnd, msg, wparam, lparam);
+                dcomp_guarded_forward(orig, hwnd, msg, wparam, lparam);
             else
                 DefWindowProcW(hwnd, msg, wparam, lparam);
             dcomp_reblit_comp_buffer(hwnd, "popup-paint");
@@ -660,7 +688,7 @@ static LRESULT CALLBACK dcomp_popup_wndproc(HWND hwnd, UINT msg, WPARAM wparam,
             }
 
             dcomp_restore_parent_clip(hwnd);
-            result = orig ? CallWindowProcW(orig, hwnd, msg, wparam, lparam)
+            result = orig ? dcomp_guarded_forward(orig, hwnd, msg, wparam, lparam)
                          : DefWindowProcW(hwnd, msg, wparam, lparam);
             RemovePropW(hwnd, WINE_DCOMP_ORIG_WNDPROC_PROP);
             RemovePropW(hwnd, WINE_DCOMP_SUBCLASS_PROC_PROP);
@@ -671,7 +699,7 @@ static LRESULT CALLBACK dcomp_popup_wndproc(HWND hwnd, UINT msg, WPARAM wparam,
         }
     }
 
-    return orig ? CallWindowProcW(orig, hwnd, msg, wparam, lparam)
+    return orig ? dcomp_guarded_forward(orig, hwnd, msg, wparam, lparam)
                 : DefWindowProcW(hwnd, msg, wparam, lparam);
 }
 
@@ -718,7 +746,7 @@ static LRESULT CALLBACK dcomp_target_wndproc(HWND hwnd, UINT msg, WPARAM wparam,
             int update_type = update_rgn ? GetUpdateRgn(hwnd, update_rgn, FALSE) : ERROR;
 
             if (orig)
-                CallWindowProcW(orig, hwnd, msg, wparam, lparam);
+                dcomp_guarded_forward(orig, hwnd, msg, wparam, lparam);
             else
                 DefWindowProcW(hwnd, msg, wparam, lparam);
 
@@ -774,7 +802,7 @@ static LRESULT CALLBACK dcomp_target_wndproc(HWND hwnd, UINT msg, WPARAM wparam,
         case WM_WINDOWPOSCHANGED:
         {
             const WINDOWPOS *wp = (const WINDOWPOS *)lparam;
-            LRESULT result = orig ? CallWindowProcW(orig, hwnd, msg, wparam, lparam)
+            LRESULT result = orig ? dcomp_guarded_forward(orig, hwnd, msg, wparam, lparam)
                                   : DefWindowProcW(hwnd, msg, wparam, lparam);
             /* Only reblit when the window was actually moved, resized, or shown.
              * Pure Z-order changes (e.g. popup menu appearing above) do not
@@ -793,7 +821,7 @@ static LRESULT CALLBACK dcomp_target_wndproc(HWND hwnd, UINT msg, WPARAM wparam,
         case WM_CHILDACTIVATE:
         case WM_MOUSEACTIVATE:
         {
-            LRESULT result = orig ? CallWindowProcW(orig, hwnd, msg, wparam, lparam)
+            LRESULT result = orig ? dcomp_guarded_forward(orig, hwnd, msg, wparam, lparam)
                                   : DefWindowProcW(hwnd, msg, wparam, lparam);
             dcomp_reblit_comp_buffer(hwnd, msg == WM_ACTIVATE ? "activate" :
                     msg == WM_SHOWWINDOW ? "showwindow" :
@@ -814,7 +842,7 @@ static LRESULT CALLBACK dcomp_target_wndproc(HWND hwnd, UINT msg, WPARAM wparam,
             if (sc)
                 d3d11_swapchain_from_IDXGISwapChain4(sc)->target_hwnd = NULL;
             dcomp_restore_parent_clip(hwnd);
-            result = orig ? CallWindowProcW(orig, hwnd, msg, wparam, lparam)
+            result = orig ? dcomp_guarded_forward(orig, hwnd, msg, wparam, lparam)
                          : DefWindowProcW(hwnd, msg, wparam, lparam);
             RemovePropW(hwnd, WINE_DCOMP_ORIG_WNDPROC_PROP);
             RemovePropW(hwnd, WINE_DCOMP_SUBCLASS_PROC_PROP);
@@ -825,7 +853,7 @@ static LRESULT CALLBACK dcomp_target_wndproc(HWND hwnd, UINT msg, WPARAM wparam,
         }
     }
 
-    return orig ? CallWindowProcW(orig, hwnd, msg, wparam, lparam)
+    return orig ? dcomp_guarded_forward(orig, hwnd, msg, wparam, lparam)
                 : DefWindowProcW(hwnd, msg, wparam, lparam);
 }
 
