From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Selim Bucher <me@selim.one>
Date: Sat, 21 Nov 2026 22:52:40 +0100
Subject: [PATCH] dwrite: Index family names of a collection.

Every family lookup compared against all family names of the collection,
and building a collection looks up the family of each face: with ~7800
system faces each new collection cost millions of compares. All localized
family names now go into an rb-tree (same wcsicmp order; the first family
with a name wins, as with the scan). Omnisphere 3 patch browsing stalls
2.2-2.4 s -> one 0.5 s in 16 clicks, editor open 0.86 s -> 0.28 s; soothe3
editor open 2.6 s -> 1.8 s.
---
 dlls/dwrite/font.c | 84 ++++++++++++++++++++++++++++++++++++----------
 1 file changed, 67 insertions(+), 17 deletions(-)

diff --git a/dlls/dwrite/font.c b/dlls/dwrite/font.c
index 85d06e5c00dcee5f63f340f7db08dec2c90da655..7502d3170a7e75b8e34482a9e298dcf503ef4964 100644
--- a/dlls/dwrite/font.c
+++ b/dlls/dwrite/font.c
@@ -423,6 +423,8 @@ struct dwrite_fontcollection
     struct dwrite_fontfamily_data **family_data;
     size_t size;
     size_t count;
+    /* Every localized family name, mapped to the first family that has it. */
+    struct rb_tree family_names;
 
     struct
     {
@@ -3411,6 +3413,23 @@ static ULONG WINAPI dwritefontcollection_AddRef(IDWriteFontCollection3 *iface)
     return refcount;
 }
 
+struct family_name_entry
+{
+    struct rb_entry entry;
+    UINT32 index;
+    WCHAR name[1];
+};
+
+static int family_name_compare(const void *key, const struct rb_entry *entry)
+{
+    return wcsicmp(key, RB_ENTRY_VALUE(entry, const struct family_name_entry, entry)->name);
+}
+
+static void family_name_destroy(struct rb_entry *entry, void *context)
+{
+    free(RB_ENTRY_VALUE(entry, struct family_name_entry, entry));
+}
+
 static ULONG WINAPI dwritefontcollection_Release(IDWriteFontCollection3 *iface)
 {
     struct dwrite_fontcollection *collection = impl_from_IDWriteFontCollection3(iface);
@@ -3426,6 +3445,7 @@ static ULONG WINAPI dwritefontcollection_Release(IDWriteFontCollection3 *iface)
             release_fontfamily_data(collection->family_data[i]);
         for (i = 0; i < collection->set.count; ++i)
             release_fontset_entry(collection->set.entries[i]);
+        rb_destroy(&collection->family_names, family_name_destroy, NULL);
         free(collection->family_data);
         free(collection);
     }
@@ -3464,24 +3484,9 @@ static HRESULT WINAPI dwritefontcollection_GetFontFamily(IDWriteFontCollection3
 
 static UINT32 collection_find_family(struct dwrite_fontcollection *collection, const WCHAR *name)
 {
-    size_t i;
-
-    for (i = 0; i < collection->count; ++i)
-    {
-        IDWriteLocalizedStrings *family_name = collection->family_data[i]->familyname;
-        UINT32 j, count = IDWriteLocalizedStrings_GetCount(family_name);
-        HRESULT hr;
+    struct rb_entry *entry = rb_get(&collection->family_names, name);
 
-        for (j = 0; j < count; j++)
-        {
-            WCHAR buffer[255];
-            hr = IDWriteLocalizedStrings_GetString(family_name, j, buffer, ARRAY_SIZE(buffer));
-            if (SUCCEEDED(hr) && !wcsicmp(buffer, name))
-                return i;
-        }
-    }
-
-    return ~0u;
+    return entry ? RB_ENTRY_VALUE(entry, struct family_name_entry, entry)->index : ~0u;
 }
 
 /* A family that is not installed is looked up in the GDI FontSubstitutes key,
@@ -3821,15 +3826,59 @@ static HRESULT fontfamily_add_font(struct dwrite_fontfamily_data *family_data, s
     return S_OK;
 }
 
+static void fontcollection_remove_family_names(struct dwrite_fontcollection *collection,
+        struct dwrite_fontfamily_data *family, UINT32 index)
+{
+    UINT32 i, count = IDWriteLocalizedStrings_GetCount(family->familyname);
+
+    for (i = 0; i < count; ++i)
+    {
+        struct family_name_entry *name;
+        struct rb_entry *entry;
+        WCHAR buffer[255];
+
+        if (FAILED(IDWriteLocalizedStrings_GetString(family->familyname, i, buffer, ARRAY_SIZE(buffer))))
+            continue;
+        if (!(entry = rb_get(&collection->family_names, buffer)))
+            continue;
+        name = RB_ENTRY_VALUE(entry, struct family_name_entry, entry);
+        if (name->index != index)
+            continue;
+        rb_remove(&collection->family_names, entry);
+        free(name);
+    }
+}
+
 static HRESULT fontcollection_add_family(struct dwrite_fontcollection *collection,
         struct dwrite_fontfamily_data *family)
 {
+    UINT32 i, count = IDWriteLocalizedStrings_GetCount(family->familyname);
+
     if (!dwrite_array_reserve((void **)&collection->family_data, &collection->size, collection->count + 1,
             sizeof(*collection->family_data)))
     {
         return E_OUTOFMEMORY;
     }
 
+    for (i = 0; i < count; ++i)
+    {
+        struct family_name_entry *name;
+        WCHAR buffer[255];
+
+        if (FAILED(IDWriteLocalizedStrings_GetString(family->familyname, i, buffer, ARRAY_SIZE(buffer))))
+            continue;
+        if (rb_get(&collection->family_names, buffer))
+            continue;
+        if (!(name = malloc(offsetof(struct family_name_entry, name[wcslen(buffer) + 1]))))
+        {
+            fontcollection_remove_family_names(collection, family, collection->count);
+            return E_OUTOFMEMORY;
+        }
+        name->index = collection->count;
+        wcscpy(name->name, buffer);
+        rb_put(&collection->family_names, name->name, &name->entry);
+    }
+
     collection->family_data[collection->count++] = family;
     return S_OK;
 }
@@ -3842,6 +3891,7 @@ static void init_font_collection(struct dwrite_fontcollection *collection, IDWri
     collection->factory = factory;
     IDWriteFactory7_AddRef(collection->factory);
     collection->family_model = family_model;
+    rb_init(&collection->family_names, family_name_compare);
 }
 
 HRESULT get_filestream_from_file(IDWriteFontFile *file, IDWriteFontFileStream **stream)
