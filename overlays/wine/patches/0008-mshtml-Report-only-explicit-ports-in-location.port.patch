From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Selim Bucher <me@selim.one>
Date: Sat, 21 Nov 2026 22:52:40 +0100
Subject: [PATCH] mshtml: Report only explicit ports in location.port.

IUri reports the scheme's default port as present, so location.port was
"443" on https pages where native returns "". Adobe's QR sign-in page keys
its environment table on protocol, host name and port and got no API URL
("Something Went Wrong").
---
 dlls/mshtml/htmllocation.c | 22 +++++++++++++---------
 1 file changed, 13 insertions(+), 9 deletions(-)

diff --git a/dlls/mshtml/htmllocation.c b/dlls/mshtml/htmllocation.c
index 91ca17946f3e732c934913285d87b4eb6482ce4f..392229e22e290f63c41a627a128b075baeef0d26 100644
--- a/dlls/mshtml/htmllocation.c
+++ b/dlls/mshtml/htmllocation.c
@@ -324,7 +324,8 @@ static HRESULT WINAPI HTMLLocation_put_port(IHTMLLocation *iface, BSTR v)
 static HRESULT WINAPI HTMLLocation_get_port(IHTMLLocation *iface, BSTR *p)
 {
     HTMLLocation *This = impl_from_IHTMLLocation(iface);
-    DWORD port;
+    const WCHAR *ptr, *end;
+    BSTR authority;
     IUri *uri;
     HRESULT hres;
 
@@ -338,18 +339,21 @@ static HRESULT WINAPI HTMLLocation_get_port(IHTMLLocation *iface, BSTR *p)
         return S_OK;
     }
 
-    hres = IUri_GetPort(uri, &port);
+    /* IUri::GetPort reports the scheme's default port when the URL has none;
+     * location.port is empty in that case, so look for an explicit ":port"
+     * suffix in the authority instead. */
+    hres = IUri_GetAuthority(uri, &authority);
     if(FAILED(hres))
         return hres;
 
-    if(hres == S_OK) {
-        WCHAR buf[12];
-
-        swprintf(buf, ARRAY_SIZE(buf), L"%u", port);
-        *p = SysAllocString(buf);
-    }else {
+    ptr = end = authority + SysStringLen(authority);
+    while(ptr > authority && ptr[-1] >= '0' && ptr[-1] <= '9')
+        ptr--;
+    if(ptr > authority && ptr < end && ptr[-1] == ':')
+        *p = SysAllocStringLen(ptr, end - ptr);
+    else
         *p = SysAllocStringLen(NULL, 0);
-    }
+    SysFreeString(authority);
 
     if(!*p)
         return E_OUTOFMEMORY;
