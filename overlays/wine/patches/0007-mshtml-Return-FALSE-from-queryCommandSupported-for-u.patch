From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Selim Bucher <me@selim.one>
Date: Sat, 21 Nov 2026 22:52:40 +0100
Subject: [PATCH] mshtml: Return FALSE from queryCommandSupported() for unknown
 commands.

Adobe's delegated QR sign-in page calls
document.queryCommandSupported("copy") at top level; the E_NOTIMPL stub
threw, the script stopped before it started polling and the page stayed on
"Loading...". Native answers FALSE.
---
 dlls/mshtml/htmldoc.c | 12 ++++++++++--
 1 file changed, 10 insertions(+), 2 deletions(-)

diff --git a/dlls/mshtml/htmldoc.c b/dlls/mshtml/htmldoc.c
index 71ea5b4f6f4ce2c218519736c9a1aa69f19a80a8..8fe4e04b1ceb18abb09dcc2dc859f23902b63d54 100644
--- a/dlls/mshtml/htmldoc.c
+++ b/dlls/mshtml/htmldoc.c
@@ -1566,8 +1566,16 @@ static HRESULT WINAPI HTMLDocument_queryCommandSupported(IHTMLDocument2 *iface,
         VARIANT_BOOL *pfRet)
 {
     HTMLDocumentNode *This = impl_from_IHTMLDocument2(iface);
-    FIXME("(%p)->(%s %p)\n", This, debugstr_w(cmdID), pfRet);
-    return E_NOTIMPL;
+
+    FIXME("(%p)->(%s %p) semi-stub, reporting unsupported\n", This, debugstr_w(cmdID), pfRet);
+
+    /* Native answers FALSE for commands it doesn't know rather than failing
+     * the call; scripts feature-detect with this (e.g. "copy") and a thrown
+     * exception aborts them. */
+    if(!pfRet)
+        return E_INVALIDARG;
+    *pfRet = VARIANT_FALSE;
+    return S_OK;
 }
 
 static HRESULT WINAPI HTMLDocument_queryCommandEnabled(IHTMLDocument2 *iface, BSTR cmdID,
