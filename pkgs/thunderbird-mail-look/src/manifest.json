{
  "manifest_version": 3,
  "name": "Mail Look",
  "version": "2.0",
  "description": "Apple Mail-style message list, message header, toolbar and search; the look lives in mail-look.css.",
  "browser_specific_settings": {
    "gecko": {
      "id": "mail-look@selim.one",
      "strict_min_version": "128.0"
    }
  },
  "experiment_apis": {
    "mailLook": {
      "schema": "experiment/schema.json",
      "parent": {
        "scopes": ["addon_parent"],
        "paths": [["mailLook"]],
        "script": "experiment/implementation.js",
        "events": ["startup"]
      }
    }
  }
}
