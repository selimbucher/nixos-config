+// A bar exactly when the window asks for server-side decorations: an X11
+// window without the "no borders" hint (those never get a CHyprBar at all), or
+// an xdg toplevel whose xdg-decoration request is not client-side. GTK and
+// libadwaita never create a decoration object, and Chromium/Electron ask for
+// client-side while they draw their own frame, so none of them get one. Hyprland
+// answers every request with server-side regardless, so the request is what
+// tells us the client's intent. mostRecentlyRequested 0 means it never chose.
+bool CHyprBar::wantsServerDecorations() {
+    const auto PWINDOW = m_pWindow.lock();
+    if (!PWINDOW)
+        return false;
+
+    if (PWINDOW->m_isX11)
+        return !PWINDOW->m_X11DoesntWantBorders;
+
+    const auto XDG      = PWINDOW->m_xdgSurface.lock();
+    const auto TOPLEVEL = XDG ? XDG->m_toplevel.lock() : nullptr;
+    if (!TOPLEVEL || !PROTO::xdgDecoration)
+        return false;
+
+    for (const auto& [resource, deco] : PROTO::xdgDecoration->m_decorations) {
+        if (deco && CXDGToplevelResource::fromResource(resource) == TOPLEVEL)
+            return deco->mostRecentlyRequested != ZXDG_TOPLEVEL_DECORATION_V1_MODE_CLIENT_SIDE;
+    }
+
+    return false;
+}
