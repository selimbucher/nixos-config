+// A bar exactly when the window asks the compositor to decorate it: an X11
+// window without the "no borders" hint (those never get a CHyprBar at all), or
+// a Wayland toplevel whose decoration request is not client-side, on either
+// protocol. GTK4/libadwaita and Chromium/Electron draw their own frame and
+// ask for client-side (or create no decoration object at all), so none of
+// them get a second row of buttons. Hyprland answers every request with
+// server-side regardless, so the request is what tells us the client's
+// intent; a most recently requested mode of 0 means it never chose.
+bool CHyprBar::wantsServerDecorations() {
+    const auto PWINDOW = m_pWindow.lock();
+    if (!PWINDOW)
+        return false;
+
+    if (PWINDOW->backend().isX11())
+        return !PWINDOW->backend().traits().suggestsNoBorder;
+
+    const auto BACKEND  = dynamic_cast<Desktop::View::CWaylandBackend*>(&PWINDOW->backend());
+    const auto XDG      = BACKEND ? BACKEND->m_resource.lock() : nullptr;
+    const auto TOPLEVEL = XDG ? XDG->m_toplevel.lock() : nullptr;
+    if (!TOPLEVEL)
+        return false;
+
+    // xdg-decoration: Qt, SDL, wine, Chromium/Electron, GTK4
+    if (PROTO::xdgDecoration) {
+        for (const auto& [resource, deco] : PROTO::xdgDecoration->m_decorations) {
+            if (deco && CXDGToplevelResource::fromResource(resource) == TOPLEVEL)
+                return deco->mostRecentlyRequested != ZXDG_TOPLEVEL_DECORATION_V1_MODE_CLIENT_SIDE;
+        }
+    }
+
+    // KDE server-decoration: the only one GTK3 speaks. LibreOffice, GIMP,
+    // Inkscape and every other GTK3 app without a header bar ask for
+    // server-side here; a GTK3 app that draws a header bar asks for client-side.
+    if (PROTO::serverDecorationKDE) {
+        const auto SURFACE = XDG->m_surface.lock();
+        for (const auto& deco : PROTO::serverDecorationKDE->m_decos) {
+            if (deco && SURFACE && deco->m_surf == SURFACE)
+                return deco->m_mostRecentlyRequested != ORG_KDE_KWIN_SERVER_DECORATION_MODE_CLIENT;
+        }
+    }
+
+    return false;
+}
